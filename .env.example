# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# Neon PostgreSQL 연결 문자열
DATABASE_URL=

# 세션 서명 키 (긴 무작위 문자열)
SESSION_SECRET=

# 서버 포트 (비우면 3000)
PORT=

# DB 드라이버 (비우면 자동)
#   비움 — pg(5432)로 먼저 붙고, 네트워크 문제로 실패하면 443 드라이버로 자동 전환
#   pg   — 5432로만 붙는다
#   neon — 443(WebSocket)으로만 붙는다. 학교·회사망에서 5432가 막혔을 때
DB_DRIVER=
